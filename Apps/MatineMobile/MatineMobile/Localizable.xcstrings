      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People invited: %lld"
          }
        }
      }
    },
    "Recibes las palabras clave de otra persona.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You receive another person's keywords."
          }
        }
      }
    },
    "No se pudo preparar el uso compartido. Comprueba que iCloud esté activo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't set up sharing. Check that iCloud is on."
          }
        }
      }
    },
    "Comparte solo las palabras clave de búsqueda, no los perfiles ni lo que veis.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shares only the search keywords, not profiles or what you watch."
          }
        }
      }
    },
    "Ya recibes las palabras clave de la otra persona, y las tuyas le llegan a ella.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You now receive the other person's keywords, and yours reach them."
          }
        }
      }
    },
    "No se pudo aceptar la invitación. Ábrela otra vez cuando haya conexión y iCloud esté activo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't accept the invitation. Open it again when you're online and iCloud is on."
          }
        }
      }
    },
    "Se dejó de compartir. Conservas las palabras clave que ya habían llegado.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing stopped. You keep the keywords that had already arrived."
          }
        }
      }
    },
    "Esa cuenta no es la de este perfil.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That account is not this profile's."
          }
        }
      }
    }
