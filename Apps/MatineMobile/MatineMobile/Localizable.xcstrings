    "¿Quitar a %@ de todos los dispositivos?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@ from all devices?"
          }
        }
      }
    },
    "Los perfiles se comparten con tus otros dispositivos por iCloud. Cerrar sesión solo afecta a este; quitar borra el perfil en todos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiles are shared with your other devices through iCloud. Signing out only affects this one; removing deletes the profile on all of them."
          }
        }
      }
    },
    "Compartir con otra persona…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share with someone…"
          }
        }
      }
    },
    "Gestionar lo compartido…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage sharing…"
          }
        }
      }
