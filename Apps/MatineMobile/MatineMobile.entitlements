<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required by App Store Connect for an app that uses iCloud (CloudKit). CloudKit wakes the
	     app with silent pushes (UIBackgroundModes remote-notification): another device's
	     household changes and approvals, and keywords. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Search keywords sync through the owner's private iCloud database. CKSyncEngine also fetches at launch and on return to the app. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.io.github.anthonytw.matine</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
